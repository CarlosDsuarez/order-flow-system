# ============================================================================
# order-flow-system — plantilla de configuración
#
# Copia este archivo a `.env` (que está en .gitignore) y ajusta los valores.
# NUNCA escribas credenciales reales en este archivo de ejemplo.
#
# IMPORTANTE: los streams públicos de market data por WebSocket (order book y
# trades) de Binance USD-M Futures, Bybit y OKX NO requieren API key. Las claves
# de abajo solo se necesitarán en fases futuras para endpoints privados
# (ejecución de órdenes, cuenta). Para la fase 1 puedes dejarlas vacías.
# ============================================================================

# ---------------------------------------------------------------- Binance ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ------------------------------------------------------------------ Bybit ---
BYBIT_API_KEY=
BYBIT_API_SECRET=

# -------------------------------------------------------------------- OKX ---
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# -------------------------------------------------------------- ClickHouse ---
# Solo si usas el extra `clickhouse` (uv sync --extra clickhouse).
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=order_flow

# ----------------------------------------------------------------- QuestDB ---
# Solo si usas el extra `questdb` (uv sync --extra questdb).
# ILP = InfluxDB Line Protocol (ingesta); PG = PostgreSQL wire (consultas).
QUESTDB_HOST=localhost
QUESTDB_ILP_PORT=9009
QUESTDB_PG_PORT=8812

# ------------------------------------------------------------------ Local ---
# Directorio raíz donde se escriben los Parquet (ver order_flow.storage.parquet).
DATA_DIR=data
# Nivel de log: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
